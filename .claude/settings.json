{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/web/scripts/check-layout.mjs\" --pre",
            "timeout": 15,
            "statusMessage": "Checking the edit against recorded layouts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/web/scripts/check-layout.mjs\" --hook",
            "timeout": 15,
            "statusMessage": "Checking layout measurements"
          }
        ]
      }
    ]
  }
}
