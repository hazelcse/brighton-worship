# Supabase project. For local development, run `npx supabase start` in the repo root
# and copy the values it prints (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Used once by `npm run create-root`
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_NAME=

# Developer account (npm run create-dev): root's powers + View or act as; hidden from the team, never rostered
DEV_EMAIL=
DEV_PASSWORD=
DEV_NAME=Dev

# Songsheet worker. Server-only.
WORKER_URL=http://127.0.0.1:8000
WORKER_TOKEN=


# Server-only. Password every new member account starts with; they must change it on first login.
DEFAULT_MEMBER_PASSWORD=
